--- Manual object-level mirror of the primitive overlap trace in certification2.lean.
--- No META-LEVEL, built-in unify, or ACU attributes on encoded terms are used.
--- This is a scripted derivation experiment, NOT a complete search strategy.
--- Run: maude -no-banner -no-advise certification2.maude
--- Strategy syntax reference:
--- https://maude.lcc.uma.es/maude-manual/maude-manualch10.html

load conPanna/certification.maude

--- One equation. BOTH unifiers must appear inside one returned disjunction.
--- The final match is a regression check against Lean's overlapOutput; it does
--- not supply the unifiers to any rewrite rule. [1] requests ONE derivation,
--- not one unifier. The trace is manually mirrored by overlapPrimitiveTrace.
set trace on .
set trace eq off .
srew [1] in CERT2-DEMO : eqn(add(var(0), var(1)), add(atom(7), var(2))) using solveOverlap ;
  match disj(
    ex(ex(conj(eqn(var(2), add(atom(7), var(1))),
      conj(eqn(var(3), var(0)), eqn(var(4), add(var(1), var(0))))))),
    ex(ex(conj(eqn(var(2), var(1)),
      conj(eqn(var(3), add(atom(7), var(0))), eqn(var(4), add(var(1), var(0)))))))) .
set trace off .
--- Both freshness checks should reduce to true.
red in CERT2-DEMO : binding(eqn(var(0), add(var(0), atom(7)))) == noBinding .
red in CERT2-DEMO : clean(subst(replace(var(0)), conj(truth, ex(eqn(var(1), var(0))))))
  == ex(eqn(var(1), var(0))) .
quit
