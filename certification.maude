--- Answer-directed, OBJECT-LEVEL search for certification.lean's one-tail rule.
--- This file contains no user model, META-LEVEL calls, or unification algorithm.
--- Lean exports the native model and calls native unify FIRST. It validates all
--- bindings against the two canonical templates before sending this request.
--- Neither model metadata nor a successful search is trusted by Lean replay.
---
--- Rule states mirror the proved Lean rules:
---   Head(free(position,C)) -> Head(C), recording Decompose(position).
---   Head(rigidHole)        -> EqualCase, recording Rigid.
---   EqualCase              -> UnequalCase, using a proposed matched family.
---   UnequalCase            -> Reply, using a proposed crossed family.
---   Head(rigidHole, distinct head codes) -> CrossedCase, recording Clash.
---   CrossedCase            -> Reply, using only a proposed crossed family.
--- An absent family leaves an unsolved state: it is NOT regenerated.
--- The trace is accumulated by the rules, not a constant scripted certificate.
--- Contexts have one hole; fixed arguments are retained in Lean's typed context.
--- 'blocked' represents nonfree heads/nonrigid holes; they have no search rule.
---
--- Reference for object-level breadth-first search (not metaSearch):
--- https://maude.lcc.uma.es/maude30-manual-html/maude-manualch23.html

mod DIRECT-CERTIFICATION is
  protecting NAT .
  protecting BOOL .
  sorts Context Family Families HeadCertificate Frame Certificate Request State Reply .
  subsort Reply < State .
  ops rigidHole blocked : -> Context [ctor] .
  op free : Nat Context -> Context [ctor] .
  ops matched crossed : -> Family [ctor] .
  op nil : -> Families [ctor] .
  op cons : Family Families -> Families [ctor] .
  op contains : Families Family -> Bool .
  ops rigid clash : -> HeadCertificate [ctor] .
  op decompose : Nat HeadCertificate -> HeadCertificate [ctor] .
  op done : -> Frame [ctor] .
  op wrap : Nat Frame -> Frame [ctor] .
  op plug : Frame HeadCertificate -> HeadCertificate .
  op emit : Family -> Certificate [ctor] .
  op coverage : HeadCertificate Certificate Certificate -> Certificate [ctor] .
  op cancellation : Certificate -> Certificate [ctor] .
  op frameCancel : HeadCertificate HeadCertificate Certificate -> Certificate [ctor] .
  op frameClash : HeadCertificate HeadCertificate HeadCertificate Certificate -> Certificate [ctor] .
  ops request frameRequest : Context Families -> Request [ctor] .
  op clashRequest : Context Nat Nat Families -> Request [ctor] .
  op start : Request -> State [ctor] .
  op head : Request Context Frame -> State [ctor] .
  ops equalCase unequalCase : Request HeadCertificate -> State [ctor] .
  op frameCase : Request -> State [ctor] .
  op crossedCase : Request HeadCertificate -> State [ctor] .
  op proposed : Request Certificate -> Reply [ctor] .

  vars C : Context .
  vars F G : Family .
  var FS : Families .
  vars N L M : Nat .
  var K : Frame .
  var H : HeadCertificate .
  var R : Request .

  eq contains(nil, F) = false .
  eq contains(cons(F, FS), F) = true .
  eq contains(cons(G, FS), F) = contains(FS, F) [owise] .
  eq plug(done, H) = H .
  eq plug(wrap(N, K), H) = plug(K, decompose(N, H)) .

  rl [begin] : start(request(C, FS)) => head(request(C, FS), C, done) .
  rl [decompose] : head(R, free(N, C), K) => head(R, C, wrap(N, K)) .
  rl [rigid] : head(R, rigidHole, K) => equalCase(R, plug(K, rigid)) .
  crl [cover-equal] : equalCase(request(C, FS), H) => unequalCase(request(C, FS), H)
    if contains(FS, matched) = true .
  crl [cover-unequal] : unequalCase(request(C, FS), H) =>
    proposed(request(C, FS), coverage(H, emit(matched), emit(crossed)))
    if contains(FS, crossed) = true .

  --- Decompose the free frame and eliminate its two rigid-field equations.
  --- The second equality identifies the TWO occurrences in the atom heads.
  --- Their bags now share exactly the same head: cancellation suffices.
  --- Native crossed answers remain in FS and are checked for soundness in Lean.
  rl [frame-decompose] : start(frameRequest(C, FS)) => frameCase(frameRequest(C, FS)) .
  crl [frame-cancel] : frameCase(frameRequest(C, FS)) =>
    proposed(frameRequest(C, FS), frameCancel(rigid, rigid, cancellation(emit(matched))))
    if contains(FS, matched) = true .

  --- Same frame rule, now with DIFFERENT inner heads. Descend the common
  --- wrapper and record its actual positions. At the rigid inner sort, unequal
  --- constructor codes discharge the matched branch; only crossed is needed.
  --- Lean independently checks the real heads, their codes and atomicity.
  rl [frame-clash-decompose] : start(clashRequest(C, L, M, FS)) =>
    head(clashRequest(C, L, M, FS), C, done) .
  crl [clash] : head(clashRequest(C, L, M, FS), rigidHole, K) =>
    crossedCase(clashRequest(C, L, M, FS), plug(K, clash)) if L =/= M .
  crl [cover-crossed] : crossedCase(clashRequest(C, L, M, FS), H) =>
    proposed(clashRequest(C, L, M, FS), frameClash(rigid, rigid, H, emit(crossed)))
    if contains(FS, crossed) = true /\ contains(FS, matched) = false .
endm

--- Generic, proof-producing data algorithms. Terms retain every constructor
--- and variable index. Only declared ACU nodes are normalized; free constructor
--- arguments are handled recursively, with no arity bound. All traces below
--- are expanded Assoc/Comm/Unit/Congruence, not semantic success flags.
fmod GENERIC-CERTIFICATION-DATA is
  protecting NAT .
  protecting BOOL .
  sorts GT GTS Ns AOp AOps GA GAs GP GQ EP EPS Norm Norms EResult
    FactorResult Factors Hint Hints .
  op v : Nat -> GT [ctor] .
  op node : Nat GTS -> GT [ctor] .
  op tsNil : -> GTS [ctor] .
  op tsCons : GT GTS -> GTS [ctor] .
  op nsNil : -> Ns [ctor] .
  op nsCons : Nat Ns -> Ns [ctor] .
  op acu : Nat Nat -> AOp [ctor] .
  op opsNil : -> AOps [ctor] .
  op opsCons : AOp AOps -> AOps [ctor] .
  op answer : Ns GTS -> GA [ctor] .
  op asNil : -> GAs [ctor] .
  op asCons : GA GAs -> GAs [ctor] .
  op problem : Ns GT GT -> GP [ctor] .
  --- Hints are untrusted native-match results. The object-level rules check
  --- every image equality before emitting the factor certificate.
  op hint : Nat GTS -> Hint [ctor] .
  op hFailed : -> Hint [ctor] .
  op hsNil : -> Hints [ctor] .
  op hsCons : Hint Hints -> Hints [ctor] .
  op gRequest : AOps GP GAs GAs Hints -> GQ [ctor] .
  ops eRefl eComm eAssoc eUnit : -> EP [ctor] .
  --- Hypothesis references are accepted ONLY in worklist consequence traces,
  --- never in unconditional candidate-soundness or factor-equality traces.
  op eHyp : Nat -> EP [ctor] .
  op eSym : EP -> EP [ctor] .
  op eTrans : GT EP EP -> EP [ctor] .
  op eCongr : EPS -> EP [ctor] .
  op esNil : -> EPS [ctor] .
  op esCons : EP EPS -> EPS [ctor] .
  op norm : GT EP -> Norm [ctor] .
  op norms : GTS EPS -> Norms [ctor] .
  op proved : EP -> EResult [ctor] .
  op eFailed : -> EResult [ctor] .
  op factor : Nat GTS EPS -> FactorResult [ctor] .
  op fFailed : -> FactorResult [ctor] .
  op fsNil : -> Factors [ctor] .
  op fsCons : FactorResult Factors -> Factors [ctor] .

  op sum : Nat GT GT -> GT .
  op less : GT GT -> Bool .
  op lessArgs : GTS GTS -> Bool .
  op normal : GT AOps -> Norm .
  op normalNode : Nat GTS AOps AOps -> Norm .
  op normalArgs : GTS AOps -> Norms .
  op liftNode : Nat Norms -> Norm .
  op liftCons : Norm Norms -> Norms .
  op normalAdd : Norm Norm Nat Nat -> Norm .
  op merge : GT GT Nat Nat -> Norm .
  op insert : GT GT Nat Nat -> Norm .
  op mergeTail : GT GT GT Norm Nat Nat -> Norm .
  op mergeHead : GT EP Norm -> Norm .
  op insertTail : GT GT GT Norm Nat -> Norm .
  op swapRight : GT GT GT Nat -> EP .
  op prove : GT GT AOps -> EResult .
  op finishProof : Norm Norm -> EResult .
  op substitute : GT GTS -> GT .
  op substituteArgs : GTS GTS -> GTS .
  op getTerm : GTS Nat -> GT .
  op getAnswer : GAs Nat -> GA .
  op checkFactor : GA GA Nat GTS AOps -> FactorResult .
  op verifiedFactor : Norms Nat GTS -> FactorResult .
  op allProved : GTS -> Bool .
  op failedTerm : -> GT [ctor] .
  op factorArgs : GTS GTS AOps -> Norms .
  op factorCons : EResult Norms -> Norms .

  vars I J F U : Nat .
  vars A B C D T V : GT .
  vars TS US VS : GTS .
  vars S S2 : Ns .
  vars OS OS2 : AOps .
  vars P Q : EP .
  vars PS : EPS .
  vars N : Norm .
  vars NS : Norms .
  vars AS : GAs .
  var X : GA .

  eq sum(F, A, B) = node(F, tsCons(A, tsCons(B, tsNil))) .
  eq less(v(I), v(J)) = I < J .
  eq less(v(I), node(F, TS)) = true .
  eq less(node(F, TS), v(I)) = false .
  eq less(node(F, TS), node(J, US)) =
    if F == J then lessArgs(TS, US) else F < J fi .
  eq lessArgs(tsNil, tsNil) = false .
  eq lessArgs(tsNil, tsCons(A, TS)) = true .
  eq lessArgs(tsCons(A, TS), tsNil) = false .
  eq lessArgs(tsCons(A, TS), tsCons(B, US)) =
    if A == B then lessArgs(TS, US) else less(A, B) fi .

  eq normal(v(I), OS) = norm(v(I), eRefl) .
  eq normal(node(F, TS), OS) = normalNode(F, TS, OS, OS) .
  eq normalNode(F, tsCons(A, tsCons(B, tsNil)), opsCons(acu(F, U), OS), OS2) =
    normalAdd(normal(A, OS2), normal(B, OS2), F, U) .
  eq normalNode(F, TS, opsCons(acu(J, U), OS), OS2) = normalNode(F, TS, OS, OS2) [owise] .
  eq normalNode(F, TS, opsNil, OS2) = liftNode(F, normalArgs(TS, OS2)) .
  eq normalArgs(tsNil, OS) = norms(tsNil, esNil) .
  eq normalArgs(tsCons(A, TS), OS) = liftCons(normal(A, OS), normalArgs(TS, OS)) .
  eq liftNode(F, norms(TS, PS)) = norm(node(F, TS), eCongr(PS)) .
  eq liftCons(norm(A, P), norms(TS, PS)) = norms(tsCons(A, TS), esCons(P, PS)) .
  eq normalAdd(norm(A, P), norm(B, Q), F, U) =
    mergeHead(sum(F, A, B), eCongr(esCons(P, esCons(Q, esNil))), merge(A, B, F, U)) .
  eq mergeHead(T, P, norm(V, Q)) = norm(V, eTrans(T, P, Q)) .

  eq merge(node(U, tsNil), B, F, U) = norm(B, eUnit) .
  eq merge(node(F, tsCons(A, tsCons(B, tsNil))), C, F, U) =
    mergeTail(A, B, C, merge(B, C, F, U), F, U) .
  eq merge(A, B, F, U) = insert(A, B, F, U) [owise] .
  eq mergeTail(A, B, C, norm(T, P), F, U) =
    mergeHead(sum(F, A, T),
      eTrans(sum(F, A, sum(F, B, C)), eAssoc, eCongr(esCons(eRefl, esCons(P, esNil)))),
      insert(A, T, F, U)) .
  eq insert(A, node(U, tsNil), F, U) =
    norm(A, eTrans(sum(F, node(U, tsNil), A), eComm, eUnit)) .
  eq insert(A, node(F, tsCons(B, tsCons(C, tsNil))), F, U) =
    if less(B, A) then insertTail(A, B, C, insert(A, C, F, U), F)
    else norm(sum(F, A, sum(F, B, C)), eRefl) fi .
  eq insert(A, B, F, U) =
    if less(B, A) then norm(sum(F, B, A), eComm)
    else norm(sum(F, A, B), eRefl) fi [owise] .
  eq insertTail(A, B, C, norm(T, P), F) = norm(sum(F, B, T),
    eTrans(sum(F, B, sum(F, A, C)), swapRight(A, B, C, F),
      eCongr(esCons(eRefl, esCons(P, esNil))))) .
  eq swapRight(A, B, C, F) =
    eTrans(sum(F, sum(F, A, B), C), eSym(eAssoc),
      eTrans(sum(F, sum(F, B, A), C), eCongr(esCons(eComm, esCons(eRefl, esNil))), eAssoc)) .
  eq prove(A, A, OS) = proved(eRefl) .
  eq prove(A, B, OS) = finishProof(normal(A, OS), normal(B, OS)) [owise] .
  eq finishProof(norm(T, P), norm(T, Q)) = proved(eTrans(T, P, eSym(Q))) .
  eq finishProof(N, norm(T, Q)) = eFailed [owise] .

  eq substitute(v(I), TS) = getTerm(TS, I) .
  eq substitute(node(F, US), TS) = node(F, substituteArgs(US, TS)) .
  eq substituteArgs(tsNil, TS) = tsNil .
  eq substituteArgs(tsCons(A, US), TS) = tsCons(substitute(A, TS), substituteArgs(US, TS)) .
  eq getTerm(tsCons(A, TS), 0) = A .
  eq getTerm(tsCons(A, TS), s(I)) = getTerm(TS, I) .
  eq getAnswer(asCons(X, AS), 0) = X .
  eq getAnswer(asCons(X, AS), s(I)) = getAnswer(AS, I) .
  eq checkFactor(answer(S, TS), answer(S2, US), I, VS, OS) =
    verifiedFactor(factorArgs(TS, substituteArgs(US, VS), OS), I, VS) .
  eq factorArgs(tsNil, tsNil, OS) = norms(tsNil, esNil) .
  eq factorArgs(tsCons(A, TS), tsCons(B, US), OS) = factorCons(prove(A, B, OS), factorArgs(TS, US, OS)) .
  eq factorCons(proved(P), norms(TS, PS)) = norms(TS, esCons(P, PS)) .
  eq factorCons(eFailed, NS) = norms(tsCons(failedTerm, tsNil), esNil) .
  eq allProved(tsNil) = true .
  eq allProved(tsCons(failedTerm, TS)) = false .
  eq allProved(tsCons(T, TS)) = allProved(TS) [owise] .
  eq verifiedFactor(norms(TS, PS), I, US) =
    if allProved(TS) then factor(I, US, PS) else fFailed fi .
endfm

mod GENERIC-CERTIFICATION is
  protecting GENERIC-CERTIFICATION-DATA .
  sorts GenericState GenericReply .
  subsort GenericReply < GenericState .
  op gStart : GQ -> GenericState [ctor] .
  op gSound : GQ GAs EPS -> GenericState [ctor] .
  op gCover : GQ GAs Hints EPS Factors -> GenericState [ctor] .
  op gCertificate : EPS Factors -> GenericReply [ctor] .
  op gProposed : GQ GenericReply -> GenericReply [ctor] .
  vars OS : AOps . vars S S2 : Ns . vars A B : GT . vars TS : GTS .
  vars REF PROP AS : GAs . vars Q : GQ . vars PS : EPS . vars FS : Factors .
  vars P : EP . vars I : Nat . vars US : GTS . vars ES : EPS .
  vars HS REST : Hints .
  op reverseProofs : EPS -> EPS .
  op appendProof : EPS EP -> EPS .
  op reverseFactors : Factors -> Factors .
  op appendFactor : Factors FactorResult -> Factors .
  eq reverseProofs(esNil) = esNil .
  eq reverseProofs(esCons(P, PS)) = appendProof(reverseProofs(PS), P) .
  eq appendProof(esNil, P) = esCons(P, esNil) .
  vars E : EP . var F : FactorResult .
  eq appendProof(esCons(P, PS), E) = esCons(P, appendProof(PS, E)) .
  eq reverseFactors(fsNil) = fsNil .
  eq reverseFactors(fsCons(F, FS)) = appendFactor(reverseFactors(FS), F) .
  eq appendFactor(fsNil, F) = fsCons(F, fsNil) .
  var F2 : FactorResult .
  eq appendFactor(fsCons(F, FS), F2) = fsCons(F, appendFactor(FS, F2)) .
  rl [g-begin] : gStart(gRequest(OS, problem(S, A, B), REF, PROP, HS)) =>
    gSound(gRequest(OS, problem(S, A, B), REF, PROP, HS), PROP, esNil) .
  crl [g-sound] : gSound(gRequest(OS, problem(S, A, B), REF, PROP, HS), asCons(answer(S2, TS), AS), PS) =>
    gSound(gRequest(OS, problem(S, A, B), REF, PROP, HS), AS, esCons(P, PS))
    if proved(P) := prove(substitute(A, TS), substitute(B, TS), OS) .
  rl [g-cover-begin] : gSound(gRequest(OS, problem(S, A, B), REF, PROP, HS), asNil, PS) =>
    gCover(gRequest(OS, problem(S, A, B), REF, PROP, HS), REF, HS, reverseProofs(PS), fsNil) .
  crl [g-factor] : gCover(gRequest(OS, problem(S, A, B), REF, PROP, HS),
      asCons(answer(S2, TS), AS), hsCons(hint(I, US), REST), PS, FS) =>
    gCover(gRequest(OS, problem(S, A, B), REF, PROP, HS), AS, REST, PS,
      fsCons(factor(I, US, ES), FS))
    if factor(I, US, ES) := checkFactor(answer(S2, TS), getAnswer(PROP, I), I, US, OS) .
  rl [g-done] : gCover(Q, asNil, hsNil, PS, FS) => gProposed(Q, gCertificate(PS, reverseFactors(FS))) .
endm

--- Generic completeness-tree pilot. No Bakery symbols, fixed variable indices,
--- family labels, or trusted completeness flags. Control currently performs
--- one root Mutate and at most one SplitAtom, then tries equality/factor leaves.
--- Failure to close such a leaf is NOT proof of an empty solution set.
fmod WORKLIST-CERTIFICATION-DATA is
  protecting GENERIC-CERTIFICATION-DATA .
  sorts CE CEs RW RWs Lookup SplitChoice CT CQ .
  op ce : GT GT -> CE [ctor] .
  op cesNil : -> CEs [ctor] .
  op cesCons : CE CEs -> CEs [ctor] .
  op rw : Nat GT EP -> RW [ctor] .
  op rwsNil : -> RWs [ctor] .
  op rwsCons : RW RWs -> RWs [ctor] .
  op found : GT EP -> Lookup [ctor] .
  op absent : -> Lookup [ctor] .
  op splitChoice : Nat GT GT GT EP -> SplitChoice [ctor] .
  op noSplit : -> SplitChoice [ctor] .
  op cLeaf : GTS EPS -> CT [ctor] .
  op cMutate : Nat GT GT GT GT EP CT -> CT [ctor] .
  op cSplit : Nat GT GT GT EP CT CT -> CT [ctor] .
  op cRequest : AOps Ns Nat GT GT -> CQ [ctor] .
  op shift : GT Nat -> GT .
  op shiftArgs : GTS Nat -> GTS .
  op shiftEqs : CEs Nat -> CEs .
  op indices : Ns Nat -> GTS .
  op mutateEqs : Nat GT GT GT GT CEs -> CEs .
  op freeHead : Nat AOps -> Bool .
  op lookupACU : Nat AOps -> AOp .
  op chooseSplit : CEs AOps Nat -> SplitChoice .
  op lookup : Nat RWs -> Lookup .
  op rewrite : GT RWs -> Norm .
  op rewriteVar : Nat Lookup RWs -> Norm .
  op rewriteArgs : GTS RWs -> Norms .
  op normalized : GT RWs AOps -> Norm .
  op normalizeRewrite : Norm AOps -> Norm .
  op normalizedArgs : GTS RWs AOps -> Norms .
  op occurs : Nat GT -> Bool .
  op occursArgs : Nat GTS -> Bool .
  op simplify : CEs Nat RWs AOps -> RWs .
  op solve : GT GT Norm Norm Nat RWs -> RWs .
  op finishLeaf : Norms -> CT .
  op ready : CT -> Bool .

  vars I J F U K : Nat . vars A B C D T : GT . vars TS US : GTS .
  vars ES : CEs . vars OS : AOps . vars S : Ns . vars RS : RWs .
  vars P Q : EP . vars PS : EPS . vars N : Norm . vars L R : CT .
  eq shift(v(I), K) = v(I + K) .
  eq shift(node(F, TS), K) = node(F, shiftArgs(TS, K)) .
  eq shiftArgs(tsNil, K) = tsNil .
  eq shiftArgs(tsCons(A, TS), K) = tsCons(shift(A, K), shiftArgs(TS, K)) .
  eq shiftEqs(cesNil, K) = cesNil .
  eq shiftEqs(cesCons(ce(A, B), ES), K) = cesCons(ce(shift(A, K), shift(B, K)), shiftEqs(ES, K)) .
  eq indices(nsNil, I) = tsNil .
  eq indices(nsCons(J, S), I) = tsCons(v(I), indices(S, s(I))) .
  eq mutateEqs(F, A, B, C, D, ES) =
    cesCons(ce(shift(A, 4), sum(F, v(0), v(1))),
    cesCons(ce(shift(B, 4), sum(F, v(2), v(3))),
    cesCons(ce(shift(C, 4), sum(F, v(0), v(2))),
    cesCons(ce(shift(D, 4), sum(F, v(1), v(3))), shiftEqs(ES, 4))))) .
  eq freeHead(F, opsNil) = true .
  eq freeHead(F, opsCons(acu(F, U), OS)) = false .
  eq freeHead(U, opsCons(acu(F, U), OS)) = false .
  eq freeHead(J, opsCons(acu(F, U), OS)) = freeHead(J, OS) [owise] .
  eq lookupACU(F, opsCons(acu(F, U), OS)) = acu(F, U) .
  eq lookupACU(F, opsCons(acu(J, U), OS)) = lookupACU(F, OS) [owise] .
  eq chooseSplit(cesNil, OS, I) = noSplit .
  ceq chooseSplit(cesCons(ce(node(J, TS), node(F, tsCons(A, tsCons(B, tsNil)))), ES), OS, I) =
    splitChoice(F, A, B, node(J, TS), eSym(eHyp(I))) if freeHead(J, OS) .
  ceq chooseSplit(cesCons(ce(node(F, tsCons(A, tsCons(B, tsNil))), node(J, TS)), ES), OS, I) =
    splitChoice(F, A, B, node(J, TS), eHyp(I)) if freeHead(J, OS) .
  eq chooseSplit(cesCons(ce(A, B), ES), OS, I) = chooseSplit(ES, OS, s(I)) [owise] .

  eq lookup(I, rwsNil) = absent .
  eq lookup(I, rwsCons(rw(I, T, P), RS)) = found(T, P) .
  eq lookup(I, rwsCons(rw(J, T, P), RS)) = lookup(I, RS) [owise] .
  eq rewrite(v(I), RS) = rewriteVar(I, lookup(I, RS), RS) .
  eq rewriteVar(I, absent, RS) = norm(v(I), eRefl) .
  eq rewriteVar(I, found(T, P), RS) = mergeHead(T, P, rewrite(T, RS)) .
  eq rewrite(node(F, TS), RS) = liftNode(F, rewriteArgs(TS, RS)) .
  eq rewriteArgs(tsNil, RS) = norms(tsNil, esNil) .
  eq rewriteArgs(tsCons(A, TS), RS) = liftCons(rewrite(A, RS), rewriteArgs(TS, RS)) .
  eq normalized(T, RS, OS) = normalizeRewrite(rewrite(T, RS), OS) .
  eq normalizeRewrite(norm(T, P), OS) = mergeHead(T, P, normal(T, OS)) .
  eq normalizedArgs(tsNil, RS, OS) = norms(tsNil, esNil) .
  eq normalizedArgs(tsCons(A, TS), RS, OS) = liftCons(normalized(A, RS, OS), normalizedArgs(TS, RS, OS)) .
  eq occurs(I, v(J)) = I == J .
  eq occurs(I, node(F, TS)) = occursArgs(I, TS) .
  eq occursArgs(I, tsNil) = false .
  eq occursArgs(I, tsCons(A, TS)) = occurs(I, A) or occursArgs(I, TS) .
  eq simplify(cesNil, I, RS, OS) = RS .
  eq simplify(cesCons(ce(A, B), ES), I, RS, OS) =
    simplify(ES, s(I), solve(A, B, normalized(A, RS, OS), normalized(B, RS, OS), I, RS), OS) .
  ceq solve(A, B, norm(v(J), P), norm(T, Q), I, RS) =
    rwsCons(rw(J, T, eTrans(A, eSym(P), eTrans(B, eHyp(I), Q))), RS)
    if not occurs(J, T) .
  ceq solve(A, B, norm(T, P), norm(v(J), Q), I, RS) =
    rwsCons(rw(J, T, eTrans(B, eSym(Q), eTrans(A, eSym(eHyp(I)), P))), RS)
    if not occurs(J, T) .
  eq solve(A, B, N, norm(T, Q), I, RS) = RS [owise] .
  eq finishLeaf(norms(TS, PS)) = cLeaf(TS, PS) .
  eq ready(cLeaf(TS, PS)) = true .
  eq ready(cMutate(F, A, B, C, D, P, L)) = ready(L) .
  eq ready(cSplit(F, A, B, C, P, L, R)) = ready(L) and ready(R) .
endfm

mod WORKLIST-CERTIFICATION is
  protecting WORKLIST-CERTIFICATION-DATA .
  sorts CState CReply . subsort CReply < CState .
  op cStart : CQ -> CState [ctor] .
  op cPlan : CQ CT -> CState [ctor] .
  op cProposed : CQ CT -> CReply [ctor] .
  op cWork : AOps GTS CEs -> CT .
  op cClose : AOps GTS CEs -> CT .
  vars OS OS2 : AOps . vars S : Ns . vars I F U : Nat .
  vars A B C D : GT . vars IS : GTS . vars ES : CEs .
  vars P : EP . vars Q : CQ . vars TREE : CT .
  crl [c-mutate] : cStart(cRequest(OS, S, I,
      node(F, tsCons(A, tsCons(B, tsNil))), node(F, tsCons(C, tsCons(D, tsNil))))) =>
    cPlan(cRequest(OS, S, I, sum(F, A, B), sum(F, C, D)),
      cMutate(F, A, B, C, D, eHyp(0),
        cWork(OS, shiftArgs(indices(S, 0), 4),
          mutateEqs(F, A, B, C, D, cesCons(ce(sum(F, A, B), sum(F, C, D)), cesNil)))))
    if acu(F, U) := lookupACU(F, OS) .
  crl [c-split] : cWork(OS, IS, ES) =>
    cSplit(F, A, B, C, P,
      cClose(OS, IS, cesCons(ce(A, node(U, tsNil)), cesCons(ce(B, C), ES))),
      cClose(OS, IS, cesCons(ce(A, C), cesCons(ce(B, node(U, tsNil)), ES))))
    if splitChoice(F, A, B, C, P) := chooseSplit(ES, OS, 0)
    /\ acu(F, U) := lookupACU(F, OS) .
  crl [c-no-split] : cWork(OS, IS, ES) => cClose(OS, IS, ES)
    if chooseSplit(ES, OS, 0) == noSplit .
  rl [c-close] : cClose(OS, IS, ES) =>
    finishLeaf(normalizedArgs(IS, simplify(ES, 0, rwsNil, OS), OS)) .
  crl [c-finish] : cPlan(Q, TREE) => cProposed(Q, TREE) if ready(TREE) .
endm
