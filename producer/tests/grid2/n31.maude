***( {Box.box (Y? + Y?)} + {Box.box (X?)} + S? =? {Box.box ({Elem.b})} + {Box.box ({Elem.a} + {Elem.c})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag, 'S:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'Y:Bag]], '`{_`}['X:Bag], 'S:Boxes], '_|_['`{_`}['b.Elem], '`{_`}['__['a.Elem, 'c.Elem]], 'S:Boxes]) .
