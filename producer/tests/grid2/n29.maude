***( {Box.box ({Elem.c} + X?)} + {Box.box ({Elem.a} + X?)} + R? =? {Box.box (Z? + Z?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'R:Boxes, 'Z:Bag),
  '_|_['`{_`}['__['c.Elem, 'X:Bag]], '`{_`}['__['a.Elem, 'X:Bag]], 'R:Boxes], '`{_`}['__['Z:Bag, 'Z:Bag]]) .
