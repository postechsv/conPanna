***( {Box.box (X?)} + {Box.box (X? + X?)} + S? =? {Box.box (Z?)} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'S:Boxes, 'Z:Bag, 'R:Boxes),
  '_|_['`{_`}['X:Bag], '`{_`}['__['X:Bag, 'X:Bag]], 'S:Boxes], '_|_['`{_`}['Z:Bag], 'R:Boxes]) .
