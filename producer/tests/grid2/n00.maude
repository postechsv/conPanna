***( {Box.box (Y? + X?)} + S? =? {Box.box ({Elem.a} + {Elem.b})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag, 'S:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'X:Bag]], 'S:Boxes], '_|_['`{_`}['__['a.Elem, 'b.Elem]], 'S:Boxes]) .
