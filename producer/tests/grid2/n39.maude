***( {Box.box (Y? + {Elem.a})} + {Box.box ({Elem.b} + {Elem.b})} =? {Box.box (Z? + Y?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag, 'S:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'a.Elem]], '`{_`}['__['b.Elem, 'b.Elem]]], '_|_['`{_`}['__['Z:Bag, 'Y:Bag]], 'S:Boxes]) .
