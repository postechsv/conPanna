***( {Box.box ({Elem.c} + Y?)} + {Box.box (Y?)} =? {Box.box (Z?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag, 'S:Boxes),
  '_|_['`{_`}['__['c.Elem, 'Y:Bag]], '`{_`}['Y:Bag]], '_|_['`{_`}['Z:Bag], 'S:Boxes]) .
