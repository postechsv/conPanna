***( {Box.box (Z?)} + {Box.box ({Elem.b})} =? {Box.box (Z? + {Elem.c})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes),
  '_|_['`{_`}['Z:Bag], '`{_`}['b.Elem]], '_|_['`{_`}['__['Z:Bag, 'c.Elem]], 'S:Boxes]) .
