***( {Box.box (X? + Z?)} + {Box.box ({Elem.a})} + S? =? {Box.box ({Elem.c})} + {Box.box (X?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Z:Bag, 'S:Boxes),
  '_|_['`{_`}['__['X:Bag, 'Z:Bag]], '`{_`}['a.Elem], 'S:Boxes], '_|_['`{_`}['c.Elem], '`{_`}['X:Bag], 'S:Boxes]) .
