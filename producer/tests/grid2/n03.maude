***( {Box.box (Z? + Z?)} + S? =? {Box.box (X? + Z?)} + {Box.box ({Elem.a} + Z?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes, 'X:Bag),
  '_|_['`{_`}['__['Z:Bag, 'Z:Bag]], 'S:Boxes], '_|_['`{_`}['__['X:Bag, 'Z:Bag]], '`{_`}['__['a.Elem, 'Z:Bag]]]) .
