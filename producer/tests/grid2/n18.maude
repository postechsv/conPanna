***( {Box.box (Z? + Y?)} + {Box.box (Z? + {Elem.b})} =? {Box.box ({Elem.b} + {Elem.a})} + {Box.box (X? + Y?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'Y:Bag, 'X:Bag),
  '_|_['`{_`}['__['Z:Bag, 'Y:Bag]], '`{_`}['__['Z:Bag, 'b.Elem]]], '_|_['`{_`}['__['b.Elem, 'a.Elem]], '`{_`}['__['X:Bag, 'Y:Bag]]]) .
