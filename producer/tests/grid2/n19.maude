***( {Box.box ({Elem.c})} + {Box.box (Z? + {Elem.b})} =? {Box.box (X?)} + {Box.box (Y? + {Elem.b})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'X:Bag, 'Y:Bag, 'S:Boxes),
  '_|_['`{_`}['c.Elem], '`{_`}['__['Z:Bag, 'b.Elem]]], '_|_['`{_`}['X:Bag], '`{_`}['__['Y:Bag, 'b.Elem]], 'S:Boxes]) .
