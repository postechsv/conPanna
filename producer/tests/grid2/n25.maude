***( {Box.box ({Elem.b} + X?)} + S? =? {Box.box ({Elem.c})} + {Box.box (X? + {Elem.b})} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'S:Boxes),
  '_|_['`{_`}['__['b.Elem, 'X:Bag]], 'S:Boxes], '_|_['`{_`}['c.Elem], '`{_`}['__['X:Bag, 'b.Elem]]]) .
