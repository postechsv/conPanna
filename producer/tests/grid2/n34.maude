***( {Box.box (Y? + {Elem.c})} + {Box.box ({Elem.a})} =? {Box.box ({Elem.a} + {Elem.a})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'S:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'c.Elem]], '`{_`}['a.Elem]], '_|_['`{_`}['__['a.Elem, 'a.Elem]], 'S:Boxes]) .
