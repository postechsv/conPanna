***( {Box.box ({Elem.b} + {Elem.a})} + {Box.box (X? + {Elem.b})} =? {Box.box ({Elem.a} + Y?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Y:Bag, 'S:Boxes),
  '_|_['`{_`}['__['b.Elem, 'a.Elem]], '`{_`}['__['X:Bag, 'b.Elem]]], '_|_['`{_`}['__['a.Elem, 'Y:Bag]], 'S:Boxes]) .
