***( {Box.box (Y? + {Elem.c})} + S? =? {Box.box (Z? + Z?)} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'S:Boxes, 'Z:Bag, 'R:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'c.Elem]], 'S:Boxes], '_|_['`{_`}['__['Z:Bag, 'Z:Bag]], 'R:Boxes]) .
