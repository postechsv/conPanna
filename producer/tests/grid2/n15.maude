***( {Box.box ({Elem.a} + {Elem.c})} + S? =? {Box.box (X? + {Elem.a})} + {Box.box (X?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('S:Boxes, 'X:Bag),
  '_|_['`{_`}['__['a.Elem, 'c.Elem]], 'S:Boxes], '_|_['`{_`}['__['X:Bag, 'a.Elem]], '`{_`}['X:Bag], 'S:Boxes]) .
