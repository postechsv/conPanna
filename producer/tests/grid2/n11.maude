***( {Box.box ({Elem.c} + Y?)} + {Box.box (Z?)} + S? =? {Box.box (Y? + {Elem.a})} + {Box.box ({Elem.b} + {Elem.b})} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag, 'S:Boxes, 'R:Boxes),
  '_|_['`{_`}['__['c.Elem, 'Y:Bag]], '`{_`}['Z:Bag], 'S:Boxes], '_|_['`{_`}['__['Y:Bag, 'a.Elem]], '`{_`}['__['b.Elem, 'b.Elem]], 'R:Boxes]) .
