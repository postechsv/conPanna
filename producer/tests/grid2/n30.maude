***( {Box.box (X? + X?)} + {Box.box (X? + {Elem.b})} + S? =? {Box.box (X?)} + {Box.box ({Elem.a})} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'S:Boxes, 'R:Boxes),
  '_|_['`{_`}['__['X:Bag, 'X:Bag]], '`{_`}['__['X:Bag, 'b.Elem]], 'S:Boxes], '_|_['`{_`}['X:Bag], '`{_`}['a.Elem], 'R:Boxes]) .
