***( {Box.box ({Elem.c} + X?)} + {Box.box ({Elem.b})} + R? =? {Box.box (X? + Y?)} + {Box.box ({Elem.c})} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'R:Boxes, 'Y:Bag),
  '_|_['`{_`}['__['c.Elem, 'X:Bag]], '`{_`}['b.Elem], 'R:Boxes], '_|_['`{_`}['__['X:Bag, 'Y:Bag]], '`{_`}['c.Elem], 'R:Boxes]) .
