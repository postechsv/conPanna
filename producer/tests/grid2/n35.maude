***( {Box.box (Z? + Z?)} + {Box.box ({Elem.c})} + S? =? {Box.box ({Elem.a} + X?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes, 'X:Bag),
  '_|_['`{_`}['__['Z:Bag, 'Z:Bag]], '`{_`}['c.Elem], 'S:Boxes], '_|_['`{_`}['__['a.Elem, 'X:Bag]], 'S:Boxes]) .
