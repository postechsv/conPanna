***( {Box.box (X? + Y?)} + {Box.box ({Elem.c} + Y?)} + S? =? {Box.box (Y?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Y:Bag, 'S:Boxes),
  '_|_['`{_`}['__['X:Bag, 'Y:Bag]], '`{_`}['__['c.Elem, 'Y:Bag]], 'S:Boxes], '_|_['`{_`}['Y:Bag], 'S:Boxes]) .
