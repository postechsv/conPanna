***( {Box.box (Y? + Z?)} + {Box.box ({Elem.a} + Z?)} + R? =? {Box.box ({Elem.a} + X?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag, 'R:Boxes, 'X:Bag),
  '_|_['`{_`}['__['Y:Bag, 'Z:Bag]], '`{_`}['__['a.Elem, 'Z:Bag]], 'R:Boxes], '`{_`}['__['a.Elem, 'X:Bag]]) .
