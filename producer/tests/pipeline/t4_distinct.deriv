problem X? + {w(N?)} = Y? + {w(M?)}; N? = M?
answers
  0: M? := U1!, N? := U1!, X? := {w(U1!)}, Y? := {w(U1!)}
  1: M? := U1!, N? := U1!, X? := U2! + {w(U1!)}, Y? := U2! + {w(U1!)}
  2: M? := U1!, N? := U1!, X? := ∅, Y? := ∅
  3: M? := U1!, N? := U1!, X? := U2!, Y? := U2!
derivation
  ⊢ - | X? + {w(N?)} = Y? + {w(M?)}; N? = M? | -
  identify w(N?) ~ w(M?)
    equal:
      ⊢ - | w(N?) = w(M?); X? + {w(N?)} = Y? + {w(M?)}; N? = M? | -
      decomp w(N?) = w(M?)  ==>  N? = M?
      ⊢ - | N? = M?; X? + {w(N?)} = Y? + {w(M?)}; N? = M? | -
      elim M? := N?
      ⊢ M? := N? | X? + {w(N?)} = Y? + {w(N?)}; N? = N? | -
      solve X? + {w(N?)} = Y? + {w(N?)}
        vars X? Y? | aliens w(N?) | L (1,0) R (0,1) La (1) Ra (1)
        compatible - | P [(0,0)] | B [(1,1)]
        branch [(0,0)]: X? := Z1, Y? := Z1
          ⊢ M? := N?, X? := Z1, Y? := Z1 | N? = N? | -
          delete N? = N?
          ⊢ M? := N?, X? := Z1, Y? := Z1 | - | -
          cover answer 3 with U1! := N?, U2! := Z1
    distinct:
      ⊢ - | X? + {w(N?)} = Y? + {w(M?)}; N? = M? | w(N?) =/= w(M?)
      solve X? + {w(N?)} = Y? + {w(M?)}
        vars X? Y? | aliens w(N?) w(M?) | L (1,0) R (0,1) La (1,0) Ra (0,1)
        compatible - | P [(0,1)] [(1,0)] | B [(1,1)]
        branch [(0,1) (1,0)]: X? := Z1 + {w(M?)}, Y? := Z1 + {w(N?)}
          ⊢ X? := Z1 + {w(M?)}, Y? := Z1 + {w(N?)} | N? = M? | w(N?) =/= w(M?)
          elim M? := N?
          ⊢ M? := N?, X? := Z1 + {w(N?)}, Y? := Z1 + {w(N?)} | - | w(N?) =/= w(N?)
          distinct w(N?) =/= w(N?)
