problem {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})}
answers
  0: R? := {"{_}"({a})}, X? := {b}, Y? := ∅
  1: R? := {"{_}"({a} + U1!)}, X? := {b}, Y? := U1!
  2: R? := {"{_}"({b})}, X? := {a}, Y? := ∅
  3: R? := {"{_}"({b})}, X? := {a} + U1!, Y? := U1!
derivation
  ⊢ - | {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | -
  identify "{_}"(X?) ~ "{_}"({b})
    equal:
      ⊢ - | "{_}"(X?) = "{_}"({b}); {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | -
      decomp "{_}"(X?) = "{_}"({b})  ==>  X? = {b}
      ⊢ - | X? = {b}; {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | -
      elim X? := {b}
      ⊢ X? := {b} | R? + {"{_}"({b})} = {"{_}"({b})} + {"{_}"({a} + Y?)} | -
      solve R? + {"{_}"({b})} = {"{_}"({b})} + {"{_}"({a} + Y?)}
        vars R? | aliens "{_}"({b}) "{_}"({a} + Y?) | L (1) R (0) La (1,0) Ra (1,1)
        compatible 0~1 | P [(0)] [(1)] | B []
        branch [(0) (1)]: R? := {"{_}"({a} + Y?)}
          ⊢ R? := {"{_}"({a} + Y?)}, X? := {b} | - | -
          cover answer 1 with U1! := Y?
    distinct:
      ⊢ - | {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | "{_}"(X?) =/= "{_}"({b})
      identify "{_}"(X?) ~ "{_}"({a} + Y?)
        equal:
          ⊢ - | "{_}"(X?) = "{_}"({a} + Y?); {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | "{_}"(X?) =/= "{_}"({b})
          decomp "{_}"(X?) = "{_}"({a} + Y?)  ==>  X? = {a} + Y?
          ⊢ - | X? = {a} + Y?; {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | "{_}"(X?) =/= "{_}"({b})
          elim X? := {a} + Y?
          ⊢ X? := {a} + Y? | R? + {"{_}"({a} + Y?)} = {"{_}"({b})} + {"{_}"({a} + Y?)} | "{_}"({a} + Y?) =/= "{_}"({b})
          solve R? + {"{_}"({a} + Y?)} = {"{_}"({b})} + {"{_}"({a} + Y?)}
            vars R? | aliens "{_}"({a} + Y?) "{_}"({b}) | L (1) R (0) La (1,0) Ra (1,1)
            compatible - | P [(0)] [(1)] | B []
            branch [(0) (1)]: R? := {"{_}"({b})}
              ⊢ R? := {"{_}"({b})}, X? := {a} + Y? | - | "{_}"({a} + Y?) =/= "{_}"({b})
              cover answer 3 with U1! := Y?
        distinct:
          ⊢ - | {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})} | "{_}"(X?) =/= "{_}"({b}); "{_}"(X?) =/= "{_}"({a} + Y?)
          solve {"{_}"(X?)} + R? = {"{_}"({a} + Y?)} + {"{_}"({b})}
            vars R? | aliens "{_}"(X?) "{_}"({a} + Y?) "{_}"({b}) | L (1) R (0) La (1,0,0) Ra (0,1,1)
            compatible 1~2 | P [] [(1)] [(1)] | B []
            no choice
