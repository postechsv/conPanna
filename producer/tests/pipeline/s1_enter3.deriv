derivation
  ⊢ - | "<_,_,_>"(s(K?), K?, {wait(K?)} + P?) = "<_,_,_>"(s(N?), N?, {wait(N?)} + {idle} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} + Q?) | -
  decomp "<_,_,_>"(s(K?), K?, {wait(K?)} + P?) = "<_,_,_>"(s(N?), N?, {wait(N?)} + {idle} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} + Q?)  ==>  s(K?) = s(N?); K? = N?; {wait(K?)} + P? = {wait(N?)} + {idle} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} + Q?
  ⊢ - | s(K?) = s(N?); K? = N?; {wait(K?)} + P? = {wait(N?)} + {idle} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} + Q? | -
  decomp s(K?) = s(N?)  ==>  K? = N?
  ⊢ - | K? = N?; K? = N?; {wait(K?)} + P? = {wait(N?)} + {idle} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} + Q? | -
  elim N? := K?
  ⊢ N? := K? | K? = K?; P? + {wait(K?)} = {idle} + Q? + {wait(K?)} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} | -
  delete K? = K?
  ⊢ N? := K? | P? + {wait(K?)} = {idle} + Q? + {wait(K?)} + {wait(M1?)} + {wait(M2?)} + {wait(M3?)} | -
