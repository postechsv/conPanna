***( The worked example of documentation/worked-example.html:
     {box({a} + X?)} + R? =? {box(Y? + W?)} + {box(Z?)}. )
load models.maude
select SHOW .
red certify('NESTED, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
        ('X:Bag, 'Y:Bag, 'W:Bag, 'Z:Bag, 'R:Boxes),
        '_|_['`{_`}['__['a.Elem, 'X:Bag]], 'R:Boxes], '_|_['`{_`}['__['Y:Bag, 'W:Bag]], '`{_`}['Z:Bag]]) .
