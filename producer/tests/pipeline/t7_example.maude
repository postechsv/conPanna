***( The worked example of documentation/worked-example.html:
     R? + {f({a} + X?)} + {f(Y?)} =? S? + T? + {f({a} + W?)}, with fruits a, b and baskets f(-). )
load models.maude
select SHOW .
red certify('NESTED, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
        ('X:Bag, 'Y:Bag, 'W:Bag, 'R:Boxes, 'S:Boxes, 'T:Boxes),
        '_|_['R:Boxes, '`{_`}['__['a.Elem, 'X:Bag]], '`{_`}['Y:Bag]],
        '_|_['S:Boxes, 'T:Boxes, '`{_`}['__['a.Elem, 'W:Bag]]]) .
