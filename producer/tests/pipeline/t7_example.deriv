derivation
  ⊢ - | R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | -
  identify "{_}"(Y?) ~ "{_}"({a} + W?)
    equal:
      ⊢ - | "{_}"(Y?) = "{_}"({a} + W?); R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | -
      decomp "{_}"(Y?) = "{_}"({a} + W?)  ==>  Y? = {a} + W?
      ⊢ - | Y? = {a} + W?; R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | -
      elim Y? := {a} + W?
      ⊢ Y? := {a} + W? | R? + {"{_}"({a} + X?)} + {"{_}"({a} + W?)} = S? + T? + {"{_}"({a} + W?)} | -
      solve R? + {"{_}"({a} + X?)} + {"{_}"({a} + W?)} = S? + T? + {"{_}"({a} + W?)}
        vars R? S? T? | aliens "{_}"({a} + X?) "{_}"({a} + W?) | L (1,0,0) R (0,1,1) La (1,1) Ra (0,1)
        compatible 0~1 | P [(0,1,0) (0,0,1)] [(0,0,0)] | B [(1,1,0) (1,0,1)]
        branch [(0,1,0) (0,0,0)]: R? := Z1 + Z2, S? := Z1 + {"{_}"({a} + X?)}, T? := Z2
          ⊢ R? := Z1 + Z2, S? := Z1 + {"{_}"({a} + X?)}, T? := Z2, Y? := {a} + W? | - | -
          cover answer 79 with U1! := X?, U2! := Z2, U3! := W?, U4! := Z1
        branch [(0,0,1) (0,0,0)]: R? := Z1 + Z2, S? := Z1, T? := Z2 + {"{_}"({a} + X?)}
          ⊢ R? := Z1 + Z2, S? := Z1, T? := Z2 + {"{_}"({a} + X?)}, Y? := {a} + W? | - | -
          cover answer 95 with U1! := X?, U2! := Z1, U3! := W?, U4! := Z2
    distinct:
      ⊢ - | R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | "{_}"(Y?) =/= "{_}"({a} + W?)
      identify "{_}"({a} + X?) ~ "{_}"({a} + W?)
        equal:
          ⊢ - | "{_}"({a} + X?) = "{_}"({a} + W?); R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | "{_}"(Y?) =/= "{_}"({a} + W?)
          decomp "{_}"({a} + X?) = "{_}"({a} + W?)  ==>  {a} + X? = {a} + W?
          ⊢ - | {a} + X? = {a} + W?; R? + {"{_}"({a} + X?)} + {"{_}"(Y?)} = S? + T? + {"{_}"({a} + W?)} | "{_}"(Y?) =/= "{_}"({a} + W?)
          solve {a} + X? = {a} + W?
            vars X? W? | aliens a | L (1,0) R (0,1) La (1) Ra (1)
