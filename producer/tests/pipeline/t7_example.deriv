problem {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)}
answers
  0: R? := {"{_}"(∅)}, W? := ∅, X? := ∅, Y? := ∅, Z? := {a}
  1: R? := {"{_}"(∅)}, W? := ∅, X? := U1!, Y? := ∅, Z? := {a} + U1!
  2: R? := {"{_}"(U1!)}, W? := ∅, X? := ∅, Y? := U1!, Z? := {a}
  3: R? := {"{_}"(U2!)}, W? := ∅, X? := U1!, Y? := U2!, Z? := {a} + U1!
  4: R? := {"{_}"(U1!)}, W? := U1!, X? := ∅, Y? := ∅, Z? := {a}
  5: R? := {"{_}"(U2!)}, W? := U2!, X? := U1!, Y? := ∅, Z? := {a} + U1!
  6: R? := {"{_}"(U1! + U2!)}, W? := U2!, X? := ∅, Y? := U1!, Z? := {a}
  7: R? := {"{_}"(U2! + U3!)}, W? := U3!, X? := U1!, Y? := U2!, Z? := {a} + U1!
  8: R? := {"{_}"(U1!)}, W? := ∅, X? := ∅, Y? := {a}, Z? := U1!
  9: R? := {"{_}"(U2!)}, W? := ∅, X? := U1!, Y? := {a} + U1!, Z? := U2!
  10: R? := {"{_}"(U2!)}, W? := U1!, X? := U1!, Y? := {a}, Z? := U2!
  11: R? := {"{_}"(U1!)}, W? := U2!, X? := U2! + U3!, Y? := {a} + U3!, Z? := U1!
  12: R? := {"{_}"(U1!)}, W? := {a}, X? := ∅, Y? := ∅, Z? := U1!
  13: R? := {"{_}"(U2!)}, W? := {a}, X? := U1!, Y? := U1!, Z? := U2!
  14: R? := {"{_}"(U2!)}, W? := {a} + U1!, X? := U1!, Y? := ∅, Z? := U2!
  15: R? := {"{_}"(U1!)}, W? := {a} + U3!, X? := U2! + U3!, Y? := U2!, Z? := U1!
derivation
  ⊢ - | {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | -
  identify "{_}"({a} + X?) ~ "{_}"(Z?)
    equal:
      ⊢ - | "{_}"({a} + X?) = "{_}"(Z?); {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | -
      decomp "{_}"({a} + X?) = "{_}"(Z?)  ==>  {a} + X? = Z?
      ⊢ - | {a} + X? = Z?; {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | -
      elim Z? := {a} + X?
      ⊢ Z? := {a} + X? | R? + {"{_}"({a} + X?)} = {"{_}"({a} + X?)} + {"{_}"(Y? + W?)} | -
      solve R? + {"{_}"({a} + X?)} = {"{_}"({a} + X?)} + {"{_}"(Y? + W?)}
        vars R? | aliens "{_}"({a} + X?) "{_}"(Y? + W?) | L (1) R (0) La (1,0) Ra (1,1)
        compatible 0~1 | P [(0)] [(1)] | B []
        branch [(0) (1)]: R? := {"{_}"(Y? + W?)}
          ⊢ R? := {"{_}"(Y? + W?)}, Z? := {a} + X? | - | -
          cover answer 7 with U1! := X?, U2! := Y?, U3! := W?
    distinct:
      ⊢ - | {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | "{_}"({a} + X?) =/= "{_}"(Z?)
      identify "{_}"({a} + X?) ~ "{_}"(Y? + W?)
        equal:
          ⊢ - | "{_}"({a} + X?) = "{_}"(Y? + W?); {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | "{_}"({a} + X?) =/= "{_}"(Z?)
          decomp "{_}"({a} + X?) = "{_}"(Y? + W?)  ==>  {a} + X? = Y? + W?
          ⊢ - | {a} + X? = Y? + W?; {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | "{_}"({a} + X?) =/= "{_}"(Z?)
          solve {a} + X? = Y? + W?
            vars X? Y? W? | aliens a | L (1,0,0) R (0,1,1) La (1) Ra (0)
            compatible - | P [(0,1,0) (0,0,1)] | B [(1,1,0) (1,0,1)]
            branch [(0,1,0)]: W? := Z2, X? := Z1 + Z2, Y? := {a} + Z1
              ⊢ W? := Z2, X? := Z1 + Z2, Y? := {a} + Z1 | R? + {"{_}"({a} + Z1 + Z2)} = {"{_}"(Z?)} + {"{_}"({a} + Z1 + Z2)} | "{_}"({a} + Z1 + Z2) =/= "{_}"(Z?)
              solve R? + {"{_}"({a} + Z1 + Z2)} = {"{_}"(Z?)} + {"{_}"({a} + Z1 + Z2)}
                vars R? | aliens "{_}"({a} + Z1 + Z2) "{_}"(Z?) | L (1) R (0) La (1,0) Ra (1,1)
                compatible - | P [(0)] [(1)] | B []
                branch [(0) (1)]: R? := {"{_}"(Z?)}
                  ⊢ R? := {"{_}"(Z?)}, W? := Z2, X? := Z1 + Z2, Y? := {a} + Z1 | - | "{_}"({a} + Z1 + Z2) =/= "{_}"(Z?)
                  cover answer 11 with U1! := Z?, U2! := Z2, U3! := Z1
            branch [(0,0,1)]: W? := {a} + Z2, X? := Z1 + Z2, Y? := Z1
              ⊢ W? := {a} + Z2, X? := Z1 + Z2, Y? := Z1 | R? + {"{_}"({a} + Z1 + Z2)} = {"{_}"(Z?)} + {"{_}"({a} + Z1 + Z2)} | "{_}"({a} + Z1 + Z2) =/= "{_}"(Z?)
              solve R? + {"{_}"({a} + Z1 + Z2)} = {"{_}"(Z?)} + {"{_}"({a} + Z1 + Z2)}
                vars R? | aliens "{_}"({a} + Z1 + Z2) "{_}"(Z?) | L (1) R (0) La (1,0) Ra (1,1)
                compatible - | P [(0)] [(1)] | B []
                branch [(0) (1)]: R? := {"{_}"(Z?)}
                  ⊢ R? := {"{_}"(Z?)}, W? := {a} + Z2, X? := Z1 + Z2, Y? := Z1 | - | "{_}"({a} + Z1 + Z2) =/= "{_}"(Z?)
                  cover answer 15 with U1! := Z?, U2! := Z1, U3! := Z2
        distinct:
          ⊢ - | {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)} | "{_}"({a} + X?) =/= "{_}"(Z?); "{_}"({a} + X?) =/= "{_}"(Y? + W?)
          solve {"{_}"({a} + X?)} + R? = {"{_}"(Y? + W?)} + {"{_}"(Z?)}
            vars R? | aliens "{_}"({a} + X?) "{_}"(Y? + W?) "{_}"(Z?) | L (1) R (0) La (1,0,0) Ra (0,1,1)
            compatible 1~2 | P [] [(1)] [(1)] | B []
            no choice
