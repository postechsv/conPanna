***( {Box.box ({Elem.a})} + {Box.box ({Elem.b} + {Elem.c})} + S? =? {Box.box ({Elem.a} + X?)} + {Box.box (X?)} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('S:Boxes, 'X:Bag, 'R:Boxes),
  '_|_['`{_`}['a.Elem], '`{_`}['__['b.Elem, 'c.Elem]], 'S:Boxes], '_|_['`{_`}['__['a.Elem, 'X:Bag]], '`{_`}['X:Bag], 'R:Boxes]) .
