***( {Box.box (Y? + {Elem.a})} =? {Box.box ({Elem.b})} + {Box.box ({Elem.b})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'S:Boxes),
  '`{_`}['__['Y:Bag, 'a.Elem]], '_|_['`{_`}['b.Elem], '`{_`}['b.Elem], 'S:Boxes]) .
