***( {Box.box ({Elem.c} + {Elem.c})} =? {Box.box ({Elem.b})} + {Box.box ({Elem.c})} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('R:Boxes),
  '`{_`}['__['c.Elem, 'c.Elem]], '_|_['`{_`}['b.Elem], '`{_`}['c.Elem], 'R:Boxes]) .
