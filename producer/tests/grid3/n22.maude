***( {Box.box (Y? + X?)} + {Box.box (X? + X?)} + S? =? {Box.box (Y? + Y?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag, 'S:Boxes),
  '_|_['`{_`}['__['Y:Bag, 'X:Bag]], '`{_`}['__['X:Bag, 'X:Bag]], 'S:Boxes], '_|_['`{_`}['__['Y:Bag, 'Y:Bag]], 'S:Boxes]) .
