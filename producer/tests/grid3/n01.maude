***( {Box.box ({Elem.a})} =? {Box.box (X? + Y?)} + {Box.box (Y? + {Elem.b})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Y:Bag, 'S:Boxes),
  '`{_`}['a.Elem], '_|_['`{_`}['__['X:Bag, 'Y:Bag]], '`{_`}['__['Y:Bag, 'b.Elem]], 'S:Boxes]) .
