***( {Box.box ({Elem.b} + {Elem.c})} + {Box.box (X? + X?)} + R? =? {Box.box (X?)} + {Box.box (Y? + Y?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'R:Boxes, 'Y:Bag),
  '_|_['`{_`}['__['b.Elem, 'c.Elem]], '`{_`}['__['X:Bag, 'X:Bag]], 'R:Boxes], '_|_['`{_`}['X:Bag], '`{_`}['__['Y:Bag, 'Y:Bag]]]) .
