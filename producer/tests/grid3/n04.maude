***( {Box.box (Z?)} =? {Box.box ({Elem.a})} + {Box.box ({Elem.b} + {Elem.a})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes),
  '`{_`}['Z:Bag], '_|_['`{_`}['a.Elem], '`{_`}['__['b.Elem, 'a.Elem]], 'S:Boxes]) .
