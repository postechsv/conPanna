***( {Box.box ({Elem.b})} + {Box.box ({Elem.a} + Z?)} + S? =? {Box.box ({Elem.a} + Z?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes),
  '_|_['`{_`}['b.Elem], '`{_`}['__['a.Elem, 'Z:Bag]], 'S:Boxes], '_|_['`{_`}['__['a.Elem, 'Z:Bag]], 'S:Boxes]) .
