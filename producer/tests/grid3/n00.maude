***( {Box.box ({Elem.c})} + S? =? {Box.box (Y? + Y?)} + {Box.box (Y?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('S:Boxes, 'Y:Bag),
  '_|_['`{_`}['c.Elem], 'S:Boxes], '_|_['`{_`}['__['Y:Bag, 'Y:Bag]], '`{_`}['Y:Bag]]) .
