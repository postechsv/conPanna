***( {Box.box ({Elem.c})} + {Box.box ({Elem.c} + Y?)} + S? =? {Box.box ({Elem.b})} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'S:Boxes),
  '_|_['`{_`}['c.Elem], '`{_`}['__['c.Elem, 'Y:Bag]], 'S:Boxes], '`{_`}['b.Elem]) .
