***( {Box.box (Y? + Z?)} =? {Box.box ({Elem.a} + Y?)} + {Box.box ({Elem.c} + {Elem.c})} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag),
  '`{_`}['__['Y:Bag, 'Z:Bag]], '_|_['`{_`}['__['a.Elem, 'Y:Bag]], '`{_`}['__['c.Elem, 'c.Elem]]]) .
