***( {Box.box ({Elem.b})} + {Box.box (Y? + {Elem.b})} =? {Box.box ({Elem.b})} + {Box.box (Z? + {Elem.b})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'Z:Bag, 'S:Boxes),
  '_|_['`{_`}['b.Elem], '`{_`}['__['Y:Bag, 'b.Elem]]], '_|_['`{_`}['b.Elem], '`{_`}['__['Z:Bag, 'b.Elem]], 'S:Boxes]) .
