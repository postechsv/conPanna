***( {Box.box ({Elem.c})} + {Box.box (Y? + X?)} + S? =? {Box.box ({Elem.a} + Z?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag, 'S:Boxes, 'Z:Bag),
  '_|_['`{_`}['c.Elem], '`{_`}['__['Y:Bag, 'X:Bag]], 'S:Boxes], '_|_['`{_`}['__['a.Elem, 'Z:Bag]], 'S:Boxes]) .
