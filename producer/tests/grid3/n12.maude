***( {Box.box ({Elem.a} + X?)} + {Box.box (Z?)} + S? =? {Box.box ({Elem.c})} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Z:Bag, 'S:Boxes),
  '_|_['`{_`}['__['a.Elem, 'X:Bag]], '`{_`}['Z:Bag], 'S:Boxes], '_|_['`{_`}['c.Elem], 'S:Boxes]) .
