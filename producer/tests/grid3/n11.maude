***( {Box.box (X? + {Elem.a})} + {Box.box (Z?)} + R? =? {Box.box ({Elem.c} + Y?)} + R? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Z:Bag, 'R:Boxes, 'Y:Bag),
  '_|_['`{_`}['__['X:Bag, 'a.Elem]], '`{_`}['Z:Bag], 'R:Boxes], '_|_['`{_`}['__['c.Elem, 'Y:Bag]], 'R:Boxes]) .
