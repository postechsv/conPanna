***( {Box.box ({Elem.a})} =? {Box.box ({Elem.c} + Y?)} + {Box.box (X? + {Elem.a})} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag),
  '`{_`}['a.Elem], '_|_['`{_`}['__['c.Elem, 'Y:Bag]], '`{_`}['__['X:Bag, 'a.Elem]]]) .
