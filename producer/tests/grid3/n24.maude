***( {Box.box ({Elem.b} + {Elem.a})} + {Box.box ({Elem.a} + {Elem.b})} =? {Box.box (Z? + Z?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag),
  '_|_['`{_`}['__['b.Elem, 'a.Elem]], '`{_`}['__['a.Elem, 'b.Elem]]], '`{_`}['__['Z:Bag, 'Z:Bag]]) .
