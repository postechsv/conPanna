***( {Box.box ({Elem.c} + Y?)} + {Box.box (X? + {Elem.c})} =? {Box.box ({Elem.b} + {Elem.c})} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Y:Bag, 'X:Bag),
  '_|_['`{_`}['__['c.Elem, 'Y:Bag]], '`{_`}['__['X:Bag, 'c.Elem]]], '`{_`}['__['b.Elem, 'c.Elem]]) .
