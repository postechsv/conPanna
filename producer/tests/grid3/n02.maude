***( {Box.box ({Elem.c} + Z?)} + {Box.box ({Elem.a})} + S? =? {Box.box (Z?)} )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('Z:Bag, 'S:Boxes),
  '_|_['`{_`}['__['c.Elem, 'Z:Bag]], '`{_`}['a.Elem], 'S:Boxes], '`{_`}['Z:Bag]) .
