***( {Box.box (X? + {Elem.a})} =? {Box.box ({Elem.b})} + {Box.box (Y?)} + S? )
load models.maude
select SHOW .
red certify('GRID, bag('Bag, '__, 'none.Bag) &b bag('Boxes, '_|_, 'nil.Boxes), 'tup,
  ('X:Bag, 'Y:Bag, 'S:Boxes),
  '`{_`}['__['X:Bag, 'a.Elem]], '_|_['`{_`}['b.Elem], '`{_`}['Y:Bag], 'S:Boxes]) .
