***(
  Scaling tests (generated by hand-written loops, kept as plain Maude).
  S1-k: rule ENTER's left side  < s K, K, wait(K) P >  against a state with
        wait(N), idle and k further waiting processes wait(M1)..wait(Mk).
  S2-n-m: the linear equation  X1 .. Xn =? Y1 .. Ym  (Hilbert basis has n*m vectors,
        so Maude returns 2^(n*m) answers before deduplication by generality).
  Run:  maude -no-banner scale.maude
)
load producer.maude
load models.maude

fmod BAKERY-SCALE is
  including BAKERY .
  op tup : Num ProcSet Num Num ProcSet -> Tup [ctor] .
  op tup : Num ProcSet Num Num Num ProcSet -> Tup [ctor] .
  op tup : Num ProcSet Num Num Num Num ProcSet -> Tup [ctor] .
  op tup : Num ProcSet Num Num Num Num Num ProcSet -> Tup [ctor] .
endfm

fmod LINEAR is
  sorts Elem Bag Tup .
  subsort Elem < Bag .
  op none : -> Bag [ctor] .
  op __ : Bag Bag -> Bag [ctor assoc comm id: none] .
  op tup : Bag Bag Bag Bag -> Tup [ctor] .
  op tup : Bag Bag Bag Bag Bag -> Tup [ctor] .
  op tup : Bag Bag Bag Bag Bag Bag -> Tup [ctor] .
endfm

select PRODUCER .

*** S1-1
red run('BAKERY-SCALE, bag('ProcSet, '__, 'none.ProcSet), 'tup, ('K:Num, 'P:ProcSet, 'N:Num, 'M1:Num, 'Q:ProcSet),
        '<_`,_`,_>['s['K:Num], 'K:Num, '__['wait['K:Num], 'P:ProcSet]],
        '<_`,_`,_>['s['N:Num], 'N:Num, '__['wait['N:Num], 'idle.Mode, 'wait['M1:Num], 'Q:ProcSet]]) .
*** S1-2
red run('BAKERY-SCALE, bag('ProcSet, '__, 'none.ProcSet), 'tup, ('K:Num, 'P:ProcSet, 'N:Num, 'M1:Num, 'M2:Num, 'Q:ProcSet),
        '<_`,_`,_>['s['K:Num], 'K:Num, '__['wait['K:Num], 'P:ProcSet]],
        '<_`,_`,_>['s['N:Num], 'N:Num, '__['wait['N:Num], 'idle.Mode, 'wait['M1:Num], 'wait['M2:Num], 'Q:ProcSet]]) .
*** S1-3
red run('BAKERY-SCALE, bag('ProcSet, '__, 'none.ProcSet), 'tup, ('K:Num, 'P:ProcSet, 'N:Num, 'M1:Num, 'M2:Num, 'M3:Num, 'Q:ProcSet),
        '<_`,_`,_>['s['K:Num], 'K:Num, '__['wait['K:Num], 'P:ProcSet]],
        '<_`,_`,_>['s['N:Num], 'N:Num, '__['wait['N:Num], 'idle.Mode, 'wait['M1:Num], 'wait['M2:Num], 'wait['M3:Num], 'Q:ProcSet]]) .
*** S1-4
red run('BAKERY-SCALE, bag('ProcSet, '__, 'none.ProcSet), 'tup, ('K:Num, 'P:ProcSet, 'N:Num, 'M1:Num, 'M2:Num, 'M3:Num, 'M4:Num, 'Q:ProcSet),
        '<_`,_`,_>['s['K:Num], 'K:Num, '__['wait['K:Num], 'P:ProcSet]],
        '<_`,_`,_>['s['N:Num], 'N:Num, '__['wait['N:Num], 'idle.Mode, 'wait['M1:Num], 'wait['M2:Num], 'wait['M3:Num], 'wait['M4:Num], 'Q:ProcSet]]) .
*** S2-2-2
red run('LINEAR, bag('Bag, '__, 'none.Bag), 'tup, ('X1:Bag, 'X2:Bag, 'Y1:Bag, 'Y2:Bag),
        '__['X1:Bag, 'X2:Bag], '__['Y1:Bag, 'Y2:Bag]) .
*** S2-3-2
red run('LINEAR, bag('Bag, '__, 'none.Bag), 'tup, ('X1:Bag, 'X2:Bag, 'X3:Bag, 'Y1:Bag, 'Y2:Bag),
        '__['X1:Bag, 'X2:Bag, 'X3:Bag], '__['Y1:Bag, 'Y2:Bag]) .
*** S2-3-3
red run('LINEAR, bag('Bag, '__, 'none.Bag), 'tup, ('X1:Bag, 'X2:Bag, 'X3:Bag, 'Y1:Bag, 'Y2:Bag, 'Y3:Bag),
        '__['X1:Bag, 'X2:Bag, 'X3:Bag], '__['Y1:Bag, 'Y2:Bag, 'Y3:Bag]) .
quit
