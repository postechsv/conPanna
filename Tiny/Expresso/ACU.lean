/-!
Free ACU structures: the model of an operator declared associative, commutative
and with a unit, as in Maude's `op _+_ : S S -> S [assoc comm id: ∅]`.

A user registers an ACU sort over elements `E` by writing `ACU E`; its values are
written with `∅`, `{a}` and `+`. The type is the quotient of constructor terms
(`ACU.Ctor`) by the least congruence generated by the A, C and U axioms
(`ACU.Equiv`), so ordinary Lean equality on `ACU E` is equality modulo ACU.
Elements keep their own equality: there is no idempotence or other equation.

This file uses core Lean only. The bridge to Mathlib's `Multiset`, used by the
certification calculus, lives in the certification library.
-/

universe u

/-- Constructor terms of an ACU sort, before the A, C and U equations apply. -/
inductive ACU.Ctor (E : Type u) where
  | unit
  | elem (element : E)
  | plus (left right : ACU.Ctor E)

namespace ACU

variable {E : Type u}

/-- The least congruence on constructor terms generated by the ACU axioms. -/
inductive Equiv : Ctor E → Ctor E → Prop where
  | refl (a : Ctor E) : Equiv a a
  | symm {a b} : Equiv a b → Equiv b a
  | trans {a b c} : Equiv a b → Equiv b c → Equiv a c
  | congr {a a' b b'} : Equiv a a' → Equiv b b' → Equiv (.plus a b) (.plus a' b')
  | assoc (a b c) : Equiv (.plus (.plus a b) c) (.plus a (.plus b c))
  | comm (a b) : Equiv (.plus a b) (.plus b a)
  | unit_plus (a) : Equiv (.plus .unit a) a
  | plus_unit (a) : Equiv (.plus a .unit) a

def setoid (E : Type u) : Setoid (Ctor E) where
  r := Equiv
  iseqv := ⟨Equiv.refl, Equiv.symm, Equiv.trans⟩

end ACU

/-- The free ACU structure over `E`: finite bags of elements. -/
abbrev ACU (E : Type u) := Quotient (ACU.setoid E)

namespace ACU

variable {E : Type u}

/-! ## Operations and notation
The operations are the constructors lifted to the quotient. Statements use the
notation `∅`, `{a}` and `+`.
-/

def unit : ACU E := Quotient.mk _ .unit

def elem (element : E) : ACU E := Quotient.mk _ (.elem element)

def plus (left right : ACU E) : ACU E :=
  Quotient.liftOn₂ left right
    (fun a b => Quotient.mk _ (.plus a b))
    (fun _ _ _ _ ha hb => Quotient.sound (Equiv.congr ha hb))

instance : EmptyCollection (ACU E) := ⟨unit⟩

instance : Singleton E (ACU E) := ⟨elem⟩

instance : Add (ACU E) := ⟨plus⟩

theorem mk_unit : (Quotient.mk _ .unit : ACU E) = ∅ := rfl

theorem mk_elem (a : E) : (Quotient.mk _ (.elem a) : ACU E) = {a} := rfl

theorem mk_plus (a b : Ctor E) :
    (Quotient.mk _ (.plus a b) : ACU E) = Quotient.mk _ a + Quotient.mk _ b := rfl

/-! ## The ACU laws -/

theorem plus_assoc (X Y Z : ACU E) : X + Y + Z = X + (Y + Z) := by
  induction X using Quotient.inductionOn
  induction Y using Quotient.inductionOn
  induction Z using Quotient.inductionOn
  exact Quotient.sound (Equiv.assoc _ _ _)

theorem plus_comm (X Y : ACU E) : X + Y = Y + X := by
  induction X using Quotient.inductionOn
  induction Y using Quotient.inductionOn
  exact Quotient.sound (Equiv.comm _ _)

theorem unit_plus (X : ACU E) : ∅ + X = X := by
  induction X using Quotient.inductionOn
  exact Quotient.sound (Equiv.unit_plus _)

theorem plus_unit (X : ACU E) : X + ∅ = X := by
  induction X using Quotient.inductionOn
  exact Quotient.sound (Equiv.plus_unit _)

-- These instances let `ac_rfl` decide equality modulo ACU.
instance : Std.Associative (α := ACU E) (· + ·) := ⟨plus_assoc⟩

instance : Std.Commutative (α := ACU E) (· + ·) := ⟨plus_comm⟩

instance : Std.LawfulIdentity (α := ACU E) (· + ·) ∅ where
  left_id := unit_plus
  right_id := plus_unit

/-! ## Normal form: equality modulo ACU is equality of contents up to order -/

/-- The elements of a constructor term, left to right. -/
def Ctor.contents : Ctor E → List E
  | .unit => []
  | .elem a => [a]
  | .plus a b => a.contents ++ b.contents

/-- A right-nested sum of singletons. -/
def Ctor.ofList : List E → Ctor E
  | [] => .unit
  | a :: as => .plus (.elem a) (ofList as)

theorem Ctor.contents_ofList (l : List E) : (Ctor.ofList l).contents = l := by
  induction l with
  | nil => rfl
  | cons a as ih => simp [Ctor.ofList, Ctor.contents, ih]

/-- Every ACU step preserves contents up to permutation. -/
theorem Equiv.perm {a b : Ctor E} (h : Equiv a b) : a.contents.Perm b.contents := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | congr _ _ ih₁ ih₂ => exact ih₁.append ih₂
  | assoc => exact .of_eq (List.append_assoc _ _ _)
  | comm => exact List.perm_append_comm
  | unit_plus => exact .refl _
  | plus_unit => exact .of_eq (List.append_nil _)

theorem Equiv.ofList_append (l₁ l₂ : List E) :
    Equiv (.ofList (l₁ ++ l₂)) (.plus (.ofList l₁) (.ofList l₂)) := by
  induction l₁ with
  | nil => exact Equiv.symm (Equiv.unit_plus _)
  | cons a as ih => exact Equiv.trans (Equiv.congr (Equiv.refl _) ih) (Equiv.symm (Equiv.assoc _ _ _))

theorem Equiv.ofList_perm {l₁ l₂ : List E} (h : l₁.Perm l₂) : Equiv (.ofList l₁) (.ofList l₂) := by
  induction h with
  | nil => exact Equiv.refl _
  | cons _ _ ih => exact Equiv.congr (Equiv.refl _) ih
  | swap =>
    exact Equiv.trans (Equiv.symm (Equiv.assoc _ _ _))
      (Equiv.trans (Equiv.congr (Equiv.comm _ _) (Equiv.refl _)) (Equiv.assoc _ _ _))
  | trans _ _ ih₁ ih₂ => exact Equiv.trans ih₁ ih₂

/-- Every constructor term is equivalent to the rebuild of its own contents. -/
theorem Equiv.ofList_contents (a : Ctor E) : Equiv a (.ofList a.contents) := by
  induction a with
  | unit => exact Equiv.refl _
  | elem => exact Equiv.symm (Equiv.plus_unit _)
  | plus a b iha ihb =>
    exact Equiv.trans (Equiv.congr iha ihb) (Equiv.symm (Equiv.ofList_append _ _))

/-- Equal contents up to permutation means ACU-equivalent. -/
theorem Equiv.of_perm {a b : Ctor E} (h : a.contents.Perm b.contents) : Equiv a b :=
  Equiv.trans (Equiv.ofList_contents a)
    (Equiv.trans (Equiv.ofList_perm h) (Equiv.symm (Equiv.ofList_contents b)))

theorem mk_eq_mk_iff {a b : Ctor E} :
    (Quotient.mk _ a : ACU E) = Quotient.mk _ b ↔ a.contents.Perm b.contents :=
  ⟨fun h => Equiv.perm (Quotient.exact h), fun h => Quotient.sound (Equiv.of_perm h)⟩

end ACU
